<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Tests describe scenarios; XML-documenting them adds nothing. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      CA1707 forbids underscores in member names. In a test name they are the xUnit convention and
      they make a failure report read as a sentence rather than as an identifier. Switched off here
      and nowhere else: the rule still applies in the library.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Lodge.Campus/Lodge.Campus.csproj" />
  </ItemGroup>

</Project>
