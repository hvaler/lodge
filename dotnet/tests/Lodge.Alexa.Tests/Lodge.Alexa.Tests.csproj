<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Tests describe scenarios; XML-documenting them adds nothing. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- See the note in Lodge.Campus.Tests: underscores are the xUnit convention for test names. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Lodge.Alexa/Lodge.Alexa.csproj" />
  </ItemGroup>

</Project>
