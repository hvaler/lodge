{
  "$schema": ".claude/schemas/ecosystem.config.schema.json",
  "_doc": "Configuracion de organizacion para Lodge. El bloque 'database' se omite a proposito: su enum solo admite motores SQL (sqlserver|postgres|mysql|sqlite) y Lodge usa DynamoDB, y solo en el despliegue gestionado. Validar con: node .claude/scripts/validate-config.js",
  "configVersion": 1,

  "organization": {
    "name": "Lodge",
    "shortName": "Lodge",
    "namespacePrefix": "Lodge",
    "supportEmail": "",
    "website": "",
    "language": "es",
    "ide": "none"
  },

  "cloud": {
    "provider": "aws",
    "secrets": "secrets-manager",
    "storage": "s3",
    "telemetry": "otlp"
  },

  "identity": {
    "idp": "oidc-generic",
    "authority": "",
    "claims": { "roles": "roles", "name": "name", "email": "email" },
    "defaultRoles": ["Estudiante", "Docente", "Conserjeria", "TI"]
  },

  "vcs": {
    "type": "git",
    "platform": "github",
    "defaultBranch": "main",
    "branchingStrategy": "github-flow-simplificado",
    "branchNamingConvention": "feature/{code}-{description}"
  },

  "cicd": {
    "platform": "github-actions",
    "variant": "",
    "buildAgent": "",
    "buildPool": "Default",
    "serverUrl": "",
    "deployModel": "on-demand",
    "environments": []
  },

  "integrations": [],

  "hub": {
    "enabled": false,
    "url": "",
    "auth": "apikey",
    "apiKeyHeader": "X-Hub-Api-Key",
    "registerOnInstall": false
  },

  "distribution": {
    "baseUrl": "",
    "updateCheck": true
  },

  "hooks": {
    "policy": "warn",
    "blockList": []
  },

  "workflow": {
    "taskTypes": [
      { "code": "M", "label": "Hito del runbook" },
      { "code": "EV", "label": "Evolutivo / Feature" },
      { "code": "DT", "label": "Deuda tecnica / Tech debt" }
    ]
  },

  "mcp": {
    "context7Url": ""
  }
}
